# Development: what `npm run dev` uses, and a build made with `--mode development`.
# Public values, committed on purpose.

# Served from the root of localhost.
BASE_PATH=/

# OAuth client of the Google Cloud project `gom-jabbar-dev`, in Testing, where
# only Paolo can consent. It accepts two localhost redirects:
# - http://localhost:5173/ for `npm run dev`, the hot-reloading server;
# - http://localhost:4173/ for `vite preview --mode development` of a bundle
#   built with `vite build --mode development`: the real build, signing in.
# Plain `npm run preview` serves the production build, which Google refuses here.
VITE_GOOGLE_CLIENT_ID=823814955422-mcqpnr1bd04a42kimntidklhvm7pp097.apps.googleusercontent.com

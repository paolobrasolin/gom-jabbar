{
  "name": "gom-jabbar",
  "private": true,
  "license": "EUPL-1.2",
  "version": "0.13.1",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "size": "node scripts/check-size.mjs",
    "notices": "node scripts/check-notices.mjs",
    "preview": "vite preview --host",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run --coverage",
    "coverage": "COVERAGE_HTML=1 vitest run --coverage",
    "test:watch": "vitest",
    "preversion": "npm run check && npm test && npm run build && npm run size && npm run notices"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.6",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^5.0.0",
    "fake-indexeddb": "^6.0.0",
    "fast-check": "^4.10.2",
    "jsdom": "^26.0.0",
    "playwright-core": "^1.63.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.0.0"
  }
}

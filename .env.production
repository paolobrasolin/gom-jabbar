# Production: what `vite build` bakes in (nix build, CI, the Pages deploy).
# Public values, committed on purpose.

# Pages serves the app at the root of its own domain, https://gom-jabbar.618.ovh/:
# an origin no other site shares, so nothing else can read the diary (SPEC §4).
BASE_PATH=/

# OAuth client of the Google Cloud project `gom-jabbar`. It accepts only the
# Pages redirect, https://gom-jabbar.618.ovh/.
VITE_GOOGLE_CLIENT_ID=71903241828-mfe5ucgvg3shn2ghftrgq0p3o618h38l.apps.googleusercontent.com

# The backup file in the person's Drive.
VITE_DRIVE_FILE_NAME=gom-jabbar.json
